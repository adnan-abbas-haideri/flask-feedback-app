services:

  mysql-db:
    image: mysql:latest
    container_name: db

    environment:
      MYSQL_ROOT_PASSWORD: root
      MYSQL_DATABASE: devops

    volumes:
      - data:/var/lib/mysql

    networks:
      - twotier


  flask-app:
    build:
      context: .

    container_name: flask-app

    ports:
      - "5000:5000"

    depends_on:
      - mysql-db

    networks:
      - twotier

    restart: always


volumes:
  data:
    external: true


networks:
  twotier:
